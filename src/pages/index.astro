---
import { Image } from 'astro:assets'
import Base from '../layouts/Base.astro'
import Checklist from '../components/Checklist.astro'
import Hero from '../components/Hero.astro'
import ExperienceGrid from '../components/ExperienceGrid.astro'
import OrdinationCard from '../components/OrdinationCard.astro'
import OrdinationTimeline from '../components/OrdinationTimeline.astro'
import ApplyFinale from '../components/ApplyFinale.astro'
import StickyApply from '../components/StickyApply.astro'
import YouTubeFacade from '../components/YouTubeFacade.astro'
import { ordinations } from '../data/ordinations'
import hero from '../assets/images/2025/1754780918399-min.jpg'
import heiko from '../assets/images/testimonials/2026-07-5.jpeg'
import jay from '../assets/images/testimonials/2026-07-1.jpeg'
import allan from '../assets/images/testimonials/2026-05-1.jpeg'
import kris from '../assets/images/testimonials/2026-05-2.jpg'

/* The first four from the testimonials page, in its order. Each quote is word for word from that person's own page. */
const voices = [
  {
    image: heiko,
    name: 'Heiko',
    detail: 'Returning participant',
    quote: "It's much more than a normal retreat I would say, and that's why I'm here again.",
    href: '/testimonials/testimonial/2026-07-5/',
  },
  {
    image: jay,
    name: 'Jay',
    detail: 'United Kingdom',
    quote: 'It almost felt like a bitesize university degree on Buddhism. My daily meditation practice has helped me to quiet the loud inner voice.',
    href: '/testimonials/testimonial/2026-07-1/',
  },
  {
    image: allan,
    name: 'Allan',
    detail: 'Denmark',
    quote: 'I am returning home, not only with a few experiences richer, but as a richer person in a mental sense.',
    href: '/testimonials/testimonial/2026-05-1/',
  },
  {
    image: kris,
    name: 'Kris',
    detail: 'Lede, Belgium',
    quote: 'Everyone should actually learn to meditate. Something that happens far too little in our busy Western lives, but which helps to find the positive in a stressful life.',
    href: '/testimonials/testimonial/2026-05-2/',
  },
]

const eligibility = [
  'You are a man aged between 18 and 70',
  'You come from any country, culture or faith',
  'You are in good health, with no drug addictions or criminal record',
  'You have not already received full ordination as a monk',
]

/* The home page's videos, led by the one about the program itself. */
const videos = [
  {
    id: 'YnYkqjQ1iLE',
    title: 'The ordination program',
    summary: 'In a world that moves too fast, this is your invitation to pause: join people from around the world in Belgium to live simply, practice mindfulness, and discover the wisdom of the Theravada tradition for yourself.',
  },
  {
    id: 'p_iDIYavbwU',
    title: 'The path of ordination',
    summary: 'It begins with handing over everything you own, learning to chant in Pali, shaving your head before your family, and circling the chapel to become a monk.',
  },
  {
    id: 'U5VxytexduI',
    title: 'Why ordain as a monk?',
    summary: 'Still young enough to start a career or a family, learn why choosing neither and why ordaining brings more freedom to help others, not less.',
  },
  {
    id: 'iNUeMI4GzU8',
    title: 'The steps in ordaining',
    summary: 'Step inside a Thai temple for every stage of the ordination ceremony, the head shaving, the procession in white, the saffron robes offered by parents, and the chanted vote that welcomes a new monk into the community.',
  },
  {
    id: '3kiXPFnRLxU',
    title: 'What inspired you to enter the Buddhist monkhood?',
    summary: 'From a student fascinated by a teaching that puts the mind first, to temple volunteer, to a life in robes. One monk shares the journey and why there has never been a moment of regret.',
  },
  {
    id: 'G7s6eyVNwkw',
    title: 'Stress and how meditation can relieve it',
    summary: "Only a tenth of our thoughts live in the present moment; the rest spin through a past we can't change and a future that may never arrive. Meditation is how you step out of the tornado and into the calm at its center.",
  },
]
---

<Base title="International Ordination Program"
  description="Live as a Theravada Buddhist monk this summer at one of four temples in Belgium, Denmark, Germany or the UK. Dates, languages and how to apply."
  socialImage={hero}>
  <Hero
    image={hero}
    alt="Monks meditating alone among the beech trees of a sunlit forest"
    widths={[640, 960, 1280]}
    eyebrow="Summer 2027 · Four temples across Europe"
    action={{ href: '#dates', label: 'Find your dates' }}
  >
    <Fragment slot="headline">International <span>Ordination</span> Program</Fragment>
    Trade your phone for saffron robes. Spend two to three weeks living as a Theravada Buddhist monk, and come home
    with a calm that stays.
  </Hero>

  <div class="container">
    <dl class="iop-stats">
      <div>
        <dt>4 temples</dt>
        <dd>Belgium, Denmark, Germany and the UK</dd>
      </div>
      <div>
        <dt>2 to 3 weeks</dt>
        <dd>Between June and August</dd>
      </div>
      <div>
        <dt>English &amp; German</dt>
        <dd>Choose the language that suits you</dd>
      </div>
      <div>
        <dt>Men 18 to 70</dt>
        <dd>Every background welcome</dd>
      </div>
    </dl>
  </div>

  <section class="iop-section" id="dates">
    <div class="container">
      <p class="iop-kicker">Summer 2027</p>
      <h2 class="iop-title">Choose your temple</h2>
      <p class="iop-intro">
        Four ordinations, one summer. Pick the dates and language that fit your life. Each program builds to its
        ordination day, when you receive the saffron robes in front of family and friends.
      </p>
      <OrdinationTimeline ordinations={ordinations} />
      <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-4">
        {ordinations.map((ordination) => (
          <div class="col">
            <OrdinationCard ordination={ordination} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="iop-section iop-section-tinted">
    <div class="container">
      <p class="iop-kicker">What you will experience</p>
      <h2 class="iop-title">More than a retreat</h2>
      <p class="iop-intro">
        For a few weeks you live exactly as a monk does, with the same robes, the same rules and the same daily rhythm
        that has been handed down for over 2,500 years.
      </p>
      <ExperienceGrid />
    </div>
  </section>

  <section class="iop-section">
    <div class="container">
      <p class="iop-kicker">In their own words</p>
      <h2 class="iop-title">What changed for them</h2>
      <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-4 mt-2">
        {voices.map((voice) => (
          <div class="col">
            <figure class="iop-voice">
              <blockquote>
                <p>“{voice.quote}”</p>
              </blockquote>
              <figcaption>
                <Image
                  src={voice.image}
                  width={112}
                  height={112}
                  densities={[1, 2]}
                  fit="cover"
                  position="top"
                  format="webp"
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
                <span>
                  <strong>{voice.name}</strong>
                  <small>{voice.detail}</small>
                  <a href={voice.href}>Read the full story</a>
                </span>
              </figcaption>
            </figure>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="iop-section iop-section-dark">
    <div class="container">
      <p class="iop-kicker">Get to know us</p>
      <h2 class="iop-title">Hear it from the monks</h2>
      <p class="iop-intro">
        Why were we born? What is our purpose in life? What did the Buddha teach? In these videos our monks share why
        they chose to ordain, what the ceremony involves and how meditation brings inner peace.
      </p>
      <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 g-lg-5">
        {videos.map((video) => (
          <div class="col">
            <article class="iop-video">
              <YouTubeFacade id={video.id} title={video.title} />
              <h3>{video.title}</h3>
              <p>{video.summary}</p>
            </article>
          </div>
        ))}
      </div>
      <a class="iop-more" href="/media/">See photos and films from past programs</a>
    </div>
  </section>

  <section class="iop-section iop-section-tinted">
    <div class="container">
      <div class="row g-5 align-items-center">
        <div class="col-12 col-lg-5">
          <p class="iop-kicker">Is this for you?</p>
          <h2 class="iop-title">You do not need to be a Buddhist</h2>
          <p class="iop-intro">
            The training is built for people who were not raised in the tradition. Curiosity and an open mind are
            enough to begin.
          </p>
        </div>
        <div class="col-12 col-lg-7">
          <Checklist items={eligibility} />
          <a href="/about/">See the full requirements and what to bring</a>
        </div>
      </div>
    </div>
  </section>

  <ApplyFinale />

  <StickyApply />
</Base>

<style lang="scss">
  @use "../styles/mixins" as *;
  @use "../styles/tokens" as *;

  /* ---- Stats card ---- */

  .iop-stats {
    @include float-card;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem 1rem;

    dt {
      font-size: clamp(1.15rem, 2.4vw, 1.5rem);
      font-weight: 800;
      letter-spacing: -0.01em;
      color: $orange-800;
    }

    dd {
      margin: 0.2rem 0 0;
      font-size: 0.9rem;
      color: var(--bs-secondary-color);
    }

    @media (min-width: $breakpoint-md) {
      grid-template-columns: repeat(4, 1fr);
      padding: 2rem 2.25rem;

      > div + div {
        padding-left: 1.5rem;
        border-left: 1px solid $iop-line;
      }
    }
  }

  /* ---- Testimonials ---- */

  .iop-voice {
    display: flex;
    flex-direction: column;
    height: 100%;
    margin: 0;
    padding: 1.75rem 1.5rem 1.5rem;
    border-radius: $iop-radius;
    background-color: $iop-panel;

    blockquote {
      position: relative;
      flex-grow: 1;
      margin-bottom: 1.5rem;
      font-size: 1.05rem;
      line-height: 1.6;
      color: $iop-ink;

      p {
        margin: 0;
      }
    }

    figcaption {
      display: flex;
      gap: 0.85rem;
      align-items: center;
      font-size: 0.85rem;
    }

    img {
      flex-shrink: 0;
      width: 3.5rem;
      height: 3.5rem;
      border-radius: 50%;
      box-shadow: $iop-avatar-ring;
      background-color: $iop-placeholder;
    }

    strong,
    small {
      display: block;
    }

    strong {
      font-size: 1rem;
      color: $iop-ink;
    }

    small {
      color: var(--bs-secondary-color);
    }
  }

  /* ---- Videos ---- */

  .iop-video {
    h3 {
      margin: 1.25rem 0 0.5rem;
      font-size: 1.3rem;
      font-weight: 800;
    }

    p {
      margin: 0;
      line-height: 1.6;
      color: rgba(255, 255, 255, 0.72);
    }
  }
</style>
