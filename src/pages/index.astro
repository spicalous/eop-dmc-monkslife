---
import { Image } from 'astro:assets'
import Base from '../layouts/Base.astro'
import ApplyCta from '../components/ApplyCta.astro'
import NextSectionLink from '../components/NextSectionLink.astro'
import IndexTitleVideo from '../components/IndexTitleVideo.astro'
import IndexVideoTitle from '../components/IndexVideoTitle.astro'
import IconArrowUp from '../components/icons/IconArrowUp.astro'
import hero from '../assets/images/Mass-Ordination-4.webp'
---

<Base title="European Ordination Program"
  description="Why were we born? What is our purpose? Hear from monks about ordaining in Europe, what the training involves, and how meditation brings inner peace.">
  <div class="container">
    <div class="min-vh-100 d-flex flex-column">
      <div class="row flex-grow-1" id="choosing-the-monastic-life">
        <div class="col-12 col-md-6 col-lg-5 d-flex align-items-end align-items-md-center">
          <Image
            src={hero}
            widths={[400, 500]}
            sizes="(min-width: 768px) 42vw, 92vw"
            format="webp"
            class="img-fluid rounded mx-auto d-block shadow opacity-75 z-n1"
            alt="Newly ordained monks seated together at a mass ordination ceremony"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <div class="col-12 col-md-6 col-lg-7 d-flex flex-column justify-content-center">
          <div class="display-3">
            Choosing the monastic life
          </div>
          <p>
            Why were we born? What is our purpose in life? How do we attain Happiness in life? What did the Buddha teach?
          </p>
          <div>
            <ApplyCta />
          </div>
        </div>
      </div>
      <NextSectionLink href="#path-of-ordination" text="The path of ordination" />
    </div>
    <div class="min-vh-100 d-flex flex-column">
      <IndexTitleVideo
        id="path-of-ordination"
        videoId="p_iDIYavbwU"
        title="The path of ordination"
        summary="It begins with handing over everything you own, learning to chant in Pali, shaving your head before your family, and circling the chapel to become a monk."
      />
      <NextSectionLink href="#why-ordain" text="Why ordain?" />
    </div>
    <div class="min-vh-100 d-flex flex-column">
      <IndexVideoTitle
        id="why-ordain"
        videoId="U5VxytexduI"
        title="Why ordain as a monk?"
        summary="Still young enough to start a career or a family, learn why choosing neither and why ordaining brings more freedom to help others, not less."
      />
      <NextSectionLink href="#steps-to-ordination" text="Steps to ordaining" />
    </div>
    <div class="min-vh-100 d-flex flex-column">
      <IndexTitleVideo
        id="steps-to-ordination"
        videoId="iNUeMI4GzU8"
        title="The steps in ordaining"
        summary="Step inside a Thai temple for every stage of the ordination ceremony, the head shaving, the procession in white, the saffron robes offered by parents, and the chanted vote that welcomes a new monk into the community."
      />
      <NextSectionLink href="#inspiration" text="Inspiration" />
    </div>
    <div class="min-vh-100 d-flex flex-column">
      <IndexVideoTitle
        id="inspiration"
        videoId="3kiXPFnRLxU"
        title="What inspired you to enter the Buddhist monkhood?"
        summary="From a student fascinated by a teaching that puts the mind first, to temple volunteer, to a life in robes. One monk shares the journey and why there has never been a moment of regret."
      />
      <NextSectionLink href="#benefits" text="Benefits" />
    </div>
    <div class="min-vh-100 d-flex flex-column">
      <IndexTitleVideo
        id="benefits"
        videoId="G7s6eyVNwkw"
        title="Stress and how meditation can relieve it"
        summary="Only a tenth of our thoughts live in the present moment; the rest spin through a past we can't change and a future that may never arrive. Meditation is how you step out of the tornado and into the calm at its center."
      />
      <NextSectionLink href="#european-ordination-program" text="European Ordination Program" />
    </div>
    <div class="min-vh-100 d-flex flex-column">
      <IndexVideoTitle
        id="european-ordination-program"
        videoId="YnYkqjQ1iLE"
        title="European Ordination Program"
        summary="In a world that moves too fast, this is your invitation to pause: join people from around the world in Belgium to live simply, practice mindfulness, and discover the wisdom of the Theravada tradition for yourself."
      >
        <div slot="extra-xs" class="my-2 text-center">
          <ApplyCta />
        </div>
        <div slot="extra-md" class="my-2">
          <ApplyCta />
        </div>
      </IndexVideoTitle>
      <div class="row text-center flex-grow-0">
        <a href="#choosing-the-monastic-life" class="link-underline link-underline-opacity-0 py-2 lead">
          Back to top
          <br>
          <IconArrowUp />
        </a>
      </div>
    </div>
  </div>
</Base>
