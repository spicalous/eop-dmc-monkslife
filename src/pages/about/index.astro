---
import Base from '../../layouts/Base.astro'
import Checklist from '../../components/Checklist.astro'
import ExperienceGrid from '../../components/ExperienceGrid.astro'
import Hero from '../../components/Hero.astro'
import JumpNav from '../../components/JumpNav.astro'
import OrdinationCard from '../../components/OrdinationCard.astro'
import OrdinationTimeline from '../../components/OrdinationTimeline.astro'
import ApplyFinale from '../../components/ApplyFinale.astro'
import StickyApply from '../../components/StickyApply.astro'
import { ordinations } from '../../data/ordinations'
import { templesByCountry } from '../../data/temples'
import hero from '../../assets/images/2026/10.jpeg'

/* The nav's Program details menu links to the first, second and last of these ids. */
const sections = {
  dates: 'program-details--latest-news',
  program: 'program-details--what-is-the-european-ordination-program',
  eligibility: 'program-details--who-can-join',
  packing: 'program-details--what-to-bring',
  faq: 'program-details--good-to-know',
  temples: 'program-details--temples-in-europe',
}

const jumps = [
  { href: `#${sections.dates}`, label: 'Dates', detail: 'Four temples, summer 2027' },
  { href: `#${sections.program}`, label: 'The program', detail: 'Where it began and what you do' },
  { href: `#${sections.eligibility}`, label: 'Who can join', detail: 'The requirements to apply' },
  { href: `#${sections.packing}`, label: 'What to bring', detail: 'And what to leave at home' },
  { href: `#${sections.faq}`, label: 'Good to know', detail: 'Chanting, visas and monks' },
  { href: `#${sections.temples}`, label: 'Temples', detail: 'Find one near you' },
]

const itinerary = [
  { date: '12 June', activity: 'Registration' },
  { date: '12 to 18 June', activity: 'First week of training' },
  { date: '15 June', activity: 'Ceremony of shaving the hair for the first time' },
  { date: '19 June', activity: 'Ordination day', ceremony: true },
  { date: '20 to 30 June', activity: 'Training continues' },
  {
    date: '1 July onwards',
    activity: 'Stay on as a monk at the Dhammakaya temple in your home country or in Belgium, dependent on assessment (optional)',
  },
]

const qualifications = [
  'Male between 18-70 years old',
  'A person with acceptable good behaviour as observed and can be attested to by their peers',
  'A person who lives a simple life, has good health, has no contagious diseases, mental illnesses, or physical impairments',
  'A person who has no drug addictions or criminal records',
  'A written consent from a parent, guardian, spouse, or closest living relative is required for those who wish to join The European Ordination Program',
  'Applicants requiring a guarantee letter for Europe must be vouched for by Dhammakaya Temple or one of its international branch temples i.e. by a monk or temple employee',
]

const required = [
  '2 sets of white shirts and trousers',
  '1 standard white shirt used by The EU Dhammakaya branches ceremonies',
  'Sweaters',
  '1 towel',
  'Personal necessities such as soap, shampoo, toothpaste, and a toothbrush',
  '1 pair of sandals',
  'Any required medicine',
]

const notAllowed = [
  'Dangerous sharp items that could be considered as weapons',
  'Cigarettes',
  'Valuable items',
  'Mobile phones',
  'Illegal drugs',
  'Food',
  "Music players, CD's, or radios",
]
---

<Base title="Program details - European Ordination Program"
  description="Everything you need to apply: dates, itinerary, entry requirements, what to bring, and the Dhammakaya temples across Europe."
  socialImage={hero}>
  <Hero
    image={hero}
    alt="A long line of monks in saffron robes walking the alms round along a tree-lined road at sunrise"
    eyebrow="Summer 2027 · European Ordination Program"
    action={{ href: `#${sections.dates}`, label: 'Find your dates' }}
    compact
  >
    <Fragment slot="headline">Program <span>details</span></Fragment>
    While many are searching for peace outside, we believe that world peace MUST begin from each and everyone of us.
    That is why we promote the use of meditation in order to help individuals cultivate peace from within.
  </Hero>

  <JumpNav label="On this page" links={jumps} />

  <section class="iop-section" id={sections.dates}>
    <div class="container">
      <p class="iop-kicker">Latest news and announcements</p>
      <h2 class="iop-title">Summer 2027 at four temples</h2>
      <p class="iop-intro">
        In summer 2027 the program runs at four temples across Europe, in English, German or both. Pick the dates and
        language that fit your life. Each program builds to its ordination day, when you receive the saffron robes in
        front of family and friends.
      </p>
      <OrdinationTimeline ordinations={ordinations} />
      <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-4">
        {ordinations.map((ordination) => (
          <div class="col">
            <OrdinationCard ordination={ordination} />
          </div>
        ))}
      </div>

      <div class="row g-4 g-lg-5 mt-5">
        <div class="col-12 col-lg-5">
          <h3 class="iop-subtitle">Itinerary at Wat Phra Dhammakaya Belgium</h3>
          <p class="iop-intro mb-0">
            From registration to ordination day, and the weeks of training either side of it.
          </p>
        </div>
        <div class="col-12 col-lg-7">
          <ol class="iop-itinerary">
            {itinerary.map((step) => (
              <li class={step.ceremony ? 'is-ceremony' : undefined}>
                <span class="iop-itinerary-date">{step.date}</span>
                <span class="iop-itinerary-activity">{step.activity}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section class="iop-section iop-section-tinted" id={sections.program}>
    <div class="container">
      <div class="row g-4 g-lg-5">
        <div class="col-12 col-lg-5">
          <p class="iop-kicker">About the program</p>
          <h2 class="iop-title">What is the European Ordination Program?</h2>
          <p class="iop-intro mb-0">
            Open to men of all ethnicities and backgrounds, the European Ordination Program provides the opportunity to
            learn about Buddhism and a monk's way of life. Taking part in the experience will aid in the cultivation of
            one's inner peace.
          </p>
        </div>
        <div class="col-12 col-lg-7 iop-prose">
          <p>
            The European Ordination Program has been established by the vision of Luang Por Dhammajayo, the Abbot of Wat
            Phra Dhammakaya, to introduce Buddhism to the people in Europe, and others around the world. The
            program was organized for the first time in 2013 at Wat Phra Dhammakaya Belgium. Many participants in Europe
            from different countries such as England, Belgium, France, Germany, Sweden, Denmark, The Netherlands, Italy,
            Malta, Austria, and Switzerland joined the program. When it concluded, all were very satisfied with the
            program, and many had the intention to join the same program again the following year.
          </p>
          <p>
            The European committee, consisting of 29 branches of Wat Phra Dhammakaya decided to organise the program every
            year. Subsequently, more and more participants in Europe have joined and participated in the European
            Ordination Program.
          </p>
          <p>
            The European Ordination Program provides the opportunity for all qualified persons in Europe who have interest
            in studying the Dhamma of the Buddha, to use the knowledge they learn and practice from the program to benefit
            their lives with more happiness and prosperity.
          </p>
          <p>
            In the program, all participants have the opportunity to learn about the Theravada Buddhist monk's life, to
            train themselves with the Buddhist disciplines and Buddhist cultures, to practice meditation, to study a
            variety of Buddhist Dhamma topics, and to understand more about the Theravada Buddhist monk's life. The course
            of study in the program has been continuously well-developed from the beginning up until the present, by
            becoming more efficient in training those who are not raised as Buddhists, enabling them to learn and apply
            the teachings in this short period of time after the program is concluded.
          </p>
          <p>
            The Dhammakaya Foundation is a non-profit organisation, based on personal development, aiming to promote
            activities for the restoration of morality in individuals, families, societies, and the world.
          </p>
          <p>
            We therefore would like to invite all qualified persons for The Theravada-Monk Ordination to join the European
            Ordination Program again this year.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="iop-section">
    <div class="container">
      <p class="iop-kicker">What you will experience</p>
      <h2 class="iop-title">More than a retreat</h2>
      <p class="iop-intro">
        For a few weeks you live exactly as a monk does, with the same robes, the same rules and the same daily rhythm
        that has been handed down for over 2,500 years.
      </p>
      <ExperienceGrid />
    </div>
  </section>

  <section class="iop-section iop-section-tinted" id={sections.eligibility}>
    <div class="container">
      <div class="row g-4 g-lg-5">
        <div class="col-12 col-lg-5">
          <p class="iop-kicker">Registration</p>
          <h2 class="iop-title">Who can join</h2>
          <p class="iop-intro mb-0">
            You do not need to be a Buddhist. The training is built for people who were not raised in the tradition, and
            men from any country, culture or faith are welcome. Curiosity and an open mind are enough to begin.
          </p>
        </div>
        <div class="col-12 col-lg-7">
          <p class="iop-list-label">Qualifications for those who would like to join the program are:</p>
          <Checklist items={qualifications} class="mb-0" />
        </div>
      </div>
    </div>
  </section>

  <section class="iop-section" id={sections.packing}>
    <div class="container">
      <p class="iop-kicker">Packing</p>
      <h2 class="iop-title">What to bring</h2>
      <p class="iop-intro">
        Monastic life is simple, so the list is short.
      </p>
      <div class="row g-4 g-lg-5">
        <div class="col-12 col-md-6">
          <h3 class="iop-subtitle">Bring with you</h3>
          <Checklist items={required} soft class="mb-0" />
        </div>
        <div class="col-12 col-md-6">
          <h3 class="iop-subtitle">Not allowed during the training</h3>
          <Checklist items={notAllowed} soft cross class="mb-0" />
        </div>
      </div>
    </div>
  </section>

  <section class="iop-section iop-section-tinted" id={sections.faq}>
    <div class="container">
      <p class="iop-kicker">Before you apply</p>
      <h2 class="iop-title">Good to know</h2>
      <div class="row row-cols-1 row-cols-lg-3 g-4 mt-2">
        <div class="col">
          <article class="iop-note">
            <h3>Things to do before your arrival</h3>
            <p>You will need to memorise chanting text for the ordination ceremony.</p>
            <a class="btn btn-primary" href="/assets/docs/ordination-chanting.pdf">Download chanting texts</a>
            <!-- TODO finish chanting section
              <a href="/about/texts/#ordination-chanting-en">Online in English</a>
              <a href="/about/texts/#ordination-chanting-th">Online in Thai</a>
            -->
          </article>
        </div>
        <div class="col">
          <article class="iop-note">
            <h3>Do you require a letter of guarantee for a visa?</h3>
            <p>
              If you require a letter from us to submit as part of your visa request, we ask you to find someone in our
              network of Dhammakaya temples who can vouch for you. This is our policy, because we want to prevent our
              program from being used as an excuse to stay in Europe illegally. If you don't know anyone in our network,
              you can <a href={`#${sections.temples}`}>find a Dhammakaya branch temple near you</a> and an interview can
              be arranged.
            </p>
          </article>
        </div>
        <div class="col">
          <article class="iop-note">
            <h3>Are you already a monk?</h3>
            <p>
              If you want to join the program, but you have already received the full ordination (upasampadā), and are
              currently still a monk, we cannot accept you in the program. We only accept lay people at the current
              moment.
            </p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="iop-section" id={sections.temples}>
    <div class="container">
      <p class="iop-kicker">Our network</p>
      <h2 class="iop-title">Temples in Europe</h2>
      <p class="iop-intro">
        Visit a Dhammakaya temple near you to meet the monks before you apply, or to arrange an interview for a letter of
        guarantee.
      </p>
      <div class="iop-temples">
        {templesByCountry.map(({ country, flag, temples }) => (
          <div class="iop-temple-country">
            <h3><span aria-hidden="true">{flag}</span> {country}</h3>
            {temples.map((temple) => (
              <div class="iop-temple">
                <h4>{temple.title}</h4>
                <Fragment set:html={temple.content} />
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <ApplyFinale
    title="How do I join?"
    text="Fill out the form to apply for the ordination program. Note that this program is open to male participants only. We look forward to your participation."
  />

  <StickyApply />
</Base>

<style lang="scss">
  @use "../../styles/tokens" as *;

  .iop-subtitle {
    margin-bottom: 1rem;
    font-size: clamp(1.4rem, 3vw, 1.75rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: $iop-ink;
  }

  .iop-list-label {
    margin-bottom: 1rem;
    font-weight: 600;
    color: $iop-ink;
  }

  /* ---- Itinerary ---- */

  $itinerary-dot: 0.9rem;

  .iop-itinerary {
    margin: 0;
    padding: 0;
    list-style: none;

    li {
      position: relative;
      padding: 0 0 1.75rem 2.25rem;

      &:last-child {
        padding-bottom: 0;
      }

      &::before {
        content: "";
        position: absolute;
        top: 0.15rem;
        left: 0;
        z-index: 1;
        width: $itinerary-dot;
        height: $itinerary-dot;
        border-radius: 50%;
        background: linear-gradient(135deg, $orange-500, $orange-800);
      }

      /* The thread from this stop down to the next one's dot. */
      &:not(:last-child)::after {
        content: "";
        position: absolute;
        top: calc(0.15rem + #{$itinerary-dot * 0.5});
        bottom: calc(-0.15rem - #{$itinerary-dot * 0.5});
        left: calc(#{$itinerary-dot * 0.5} - 1px);
        border-left: 2px solid rgba($orange-600, 0.25);
      }
    }

    /* Ordination day wears the same ring as the timeline's ceremony marker. */
    .is-ceremony {
      &::before {
        border: 3px solid $orange-900;
        background: #fff;
      }

      .iop-itinerary-activity {
        font-weight: 800;
      }
    }
  }

  .iop-itinerary-date {
    display: block;
    margin-bottom: 0.15rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.2rem;
    text-transform: uppercase;
    color: $orange-900;
  }

  .iop-itinerary-activity {
    display: block;
    font-size: 1.1rem;
    line-height: 1.5;
    color: $iop-ink;
  }

  /* ---- Good to know ---- */

  .iop-note {
    height: 100%;
    padding: 1.75rem 1.5rem;
    border-radius: $iop-radius;
    background-color: #fff;
    box-shadow: $iop-shadow;

    h3 {
      margin-bottom: 0.75rem;
      font-size: 1.3rem;
      font-weight: 800;
      line-height: 1.25;
      color: $iop-ink;
    }

    p {
      line-height: 1.65;
      color: var(--bs-secondary-color);
    }

    p:last-child {
      margin-bottom: 0;
    }
  }

  /* ---- Temples directory ---- */

  /* Countries hold anywhere from one temple to seven, so they flow down columns rather than sit in rows. */
  .iop-temples {
    columns: 1;
    column-gap: 1.5rem;

    @media (min-width: $breakpoint-md) {
      columns: 2;
    }

    @media (min-width: $breakpoint-xl) {
      columns: 3;
    }
  }

  .iop-temple-country {
    margin-bottom: 1.5rem;
    padding: 1.5rem;
    border: 1px solid $iop-line;
    border-radius: $iop-radius;
    background-color: #fff;
    break-inside: avoid;

    h2 {
      margin-bottom: 0.25rem;
      font-size: 1.3rem;
      font-weight: 800;
      color: $iop-ink;
    }
  }

  .iop-temple {
    padding-top: 1rem;

    & + & {
      margin-top: 1rem;
      border-top: 1px solid $iop-line-soft;
    }

    h4 {
      margin-bottom: 0.35rem;
      font-size: 1rem;
      font-weight: 700;
      color: $orange-900;
    }

    /* The address is an HTML fragment from src/data/temples.ts, so it carries no scope of its own. */
    :global(address) {
      margin: 0;
      line-height: 1.6;
      color: var(--bs-secondary-color);
    }
  }
</style>
