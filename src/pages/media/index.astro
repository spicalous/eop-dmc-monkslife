---
import Base from '../../layouts/Base.astro'
import ApplyFinale from '../../components/ApplyFinale.astro'
import Gallery from '../../components/Gallery.astro'
import Hero from '../../components/Hero.astro'
import JumpNav from '../../components/JumpNav.astro'
import PortraitCard from '../../components/PortraitCard.astro'
import StickyApply from '../../components/StickyApply.astro'
import YouTube from '../../components/YouTube.astro'
import { galleryByYear } from '../../data/galleries'
import { programs } from '../../data/programs'
import hero from '../../assets/images/2026/07.jpeg'

const years = [
  {
    year: 2026,
    intro: 'The European Ordination Program for 2026 was held in Wat Phra Dhammakaya Belgium, between 8 and 28 June 2026.',
    films: [
      { id: 'mA6R8_K2Kb0', title: 'European Ordination Program 2026' },
      { id: 'QC0HZYnOhaE', title: 'European Ordination Program 2026 highlights' },
    ],
  },
  {
    year: 2025,
    intro: 'The 2025 European Ordination program took place in June with 13 participants travelling across Europe to participate in London.',
  },
  {
    year: 2023,
    intro: 'Between 8 and 30 July 2023, the ninth group of the European Ordination Program participants were ordained at Wat Phra Dhammakaya Belgium and trained by experienced teaching monks at Wat Dhammakaya Korsør Lystskov.',
  },
  {
    year: 2022,
    intro: 'Between 3 and 19 June 2022, the eighth group of European Ordination Program participants were trained under the guidance of several experienced teaching monks at the Dhammakaya Korsør Lystskov Thai temple. In total, ten participants joined to train themselves in the monastic discipline, sleeping in simple tents and practicing meditation intensively for a period of two weeks. The program was a great success this year, and many of the participants have indicated they would like the program to be held longer and would not want to miss it next year.',
  },
  {
    year: 2019,
    intro: '20 people took part in the program which took place over 4 weeks, between 17 June and 14 July 2019.',
  },
  {
    year: 2018,
    intro: 'The program took place over two weeks, starting on 4 June and ending on 15 June 2018. A total of 25 people took part from 10 countries all over Europe.',
    participants: programs[2018],
  },
].map((entry) => ({ ...entry, gallery: galleryByYear.get(entry.year) }))

/* What each year holds, for the jump links. */
function contents({ gallery, films, participants }: (typeof years)[number]): string {
  const parts = []
  if (gallery) parts.push(`${gallery.photos.length} photos`)
  if (films?.length) parts.push(`${films.length} films`)
  if (participants) parts.push('Participant portraits')
  return parts.join(' · ')
}
---

<Base title="Media - European Ordination Program"
  description="Photographs and films from the European Ordination Program."
  socialImage={hero}>
  <Hero
    image={hero}
    alt="Newly ordained monks meditating in rows on the grass beneath a vast tree"
    eyebrow="Photos and films"
    action={{ href: '/media/podcast/', label: 'The podcast' }}
    compact
  >
    <Fragment slot="headline">Past <span>programs</span></Fragment>
    Photographs and films from past European Ordination Programs, from 2018 to last summer.
  </Hero>

  <JumpNav
    label="Years on this page"
    links={years.map((entry) => ({ href: `#media-${entry.year}`, label: entry.year, detail: contents(entry) }))}
  />

  {years.map((entry, index) => (
    <section class={`iop-section${index % 2 ? ' iop-section-tinted' : ''}`} id={`media-${entry.year}`}>
      <div class="container">
        <p class="iop-kicker">European Ordination Program</p>
        <h2 class="iop-title">{entry.year}</h2>
        <p class="iop-intro">{entry.intro}</p>

        {entry.films && (
          <div class="row row-cols-1 row-cols-md-2 g-3 g-md-4 mb-4">
            {entry.films.map((film) => (
              <div class="col">
                <YouTube id={film.id} title={film.title} />
              </div>
            ))}
          </div>
        )}

        {entry.gallery && <Gallery gallery={entry.gallery} />}

        {entry.participants && (
          <div class="row row-cols-3 row-cols-sm-4 row-cols-md-6 g-4">
            {entry.participants.map((person) => (
              <div class="col">
                <PortraitCard person={person} />
              </div>
            ))}
          </div>
        )}
      </div>
    </section>
  ))}

  <ApplyFinale showDates />

  <StickyApply />
</Base>
