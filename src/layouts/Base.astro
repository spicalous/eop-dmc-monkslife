---
import 'bootstrap/dist/css/bootstrap.min.css'
import '../styles/main.scss'

import { getImage } from 'astro:assets'
import type { ImageMetadata } from 'astro'

import NavBar from '../components/NavBar.astro'
import Footer from '../components/Footer.astro'
import { SITE_NAME } from '../config/site'
import defaultSocialImage from '../assets/images/testimonials/2026-07-1/image-1.jpeg'

const SOCIAL_WIDTH = 1200
const SOCIAL_HEIGHT = 630

interface Props {
  title: string
  /** One or two sentences for search results and link previews. Roughly 150 characters. */
  description: string
  /** Overrides the shared preview image. Must be landscape and at least 1200x630. */
  socialImage?: ImageMetadata
}

const { title, description, socialImage } = Astro.props

if (!description) {
  throw new Error(`Base layout: "${title}" has no description — every page needs one for search results and link previews.`)
}

/*
 * Built pages are directories (/about/index.html), so canonicals carry a
 * trailing slash. Without normalising, dev and the built site disagree and
 * search engines see two URLs for one page.
 */
const path = Astro.url.pathname.replace(/\/+$/, '')
const canonical = new URL(`${path}/`, Astro.site)

/*
 * Facebook and X want an absolute URL and a 1.91:1 landscape image. Cropping
 * rather than fitting guarantees those exact dimensions, so the width and
 * height advertised below are always true.
 */
const socialSource = socialImage ?? defaultSocialImage
if (socialSource.width < SOCIAL_WIDTH || socialSource.height < SOCIAL_HEIGHT) {
  throw new Error(
    `Social image for "${title}" is ${socialSource.width}x${socialSource.height}; ` +
    `it must be at least ${SOCIAL_WIDTH}x${SOCIAL_HEIGHT} or the preview is upscaled.`,
  )
}
const social = await getImage({
  src: socialSource,
  width: SOCIAL_WIDTH,
  height: SOCIAL_HEIGHT,
  fit: 'cover',
  position: 'center',
  format: 'jpeg',
})
const socialUrl = new URL(social.src, Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonical}>

    <meta property="og:type" content="website">
    <meta property="og:site_name" content={SITE_NAME}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={socialUrl}>
    <meta property="og:image:width" content={String(SOCIAL_WIDTH)}>
    <meta property="og:image:height" content={String(SOCIAL_HEIGHT)}>
    <meta property="og:locale" content="en_GB">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={socialUrl}>

    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
  </head>
  <body>
    <NavBar />
    <slot />
    <Footer />
    {/* Registers Bootstrap's data-api behaviours (navbar collapse, dropdowns). */}
    <script>
      import 'bootstrap'
    </script>
  </body>
</html>
