---
import type { ImageMetadata } from 'astro'
import Base from './Base.astro'

interface Props {
  title: string
  heading: string
  description: string
  /** The testimonial's own portrait, so a shared link previews the right person. */
  socialImage?: ImageMetadata
}

const { title, heading, description, socialImage } = Astro.props
---

<Base title={title} description={description} socialImage={socialImage}>
  <div class="container">
    <div class="display-1 text-center pt-5">{heading}</div>
    <slot />
    <div class="row">
      <div class="col text-center">
        <a href="/testimonials/" class="btn btn-primary">Back</a>
      </div>
    </div>
  </div>
</Base>
