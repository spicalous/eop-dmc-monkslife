---
import { Picture } from 'astro:assets'
import type { Gallery } from '../data/galleries'

interface Props {
  gallery: Gallery
}

const { gallery } = Astro.props

/*
 * Three columns from md, two below. The lead photo spans two of them, so it
 * gets its own, larger candidates. The container tops out at 1320px, so a
 * single tile is never wider than ~430px and the lead never wider than ~870px.
 */
const TILE = { widths: [400, 620, 900], sizes: '(min-width: 768px) 31vw, 46vw' }
const LEAD = { widths: [620, 900, 1300], sizes: '(min-width: 768px) 62vw, 94vw' }
---

<div class="gallery">
  {gallery.photos.map((photo, index) => (
    <div class="gallery-item">
      <Picture
        src={photo}
        formats={['avif', 'webp']}
        {...(index === 0 ? LEAD : TILE)}
        alt={`${gallery.alt}, photo ${index + 1} of ${gallery.photos.length}`}
        class="gallery-img"
        loading="lazy"
        decoding="async"
      />
    </div>
  ))}
</div>

<style lang="scss">
  @use "../styles/tokens" as *;

  // Photos are shown as uniform 3:2 tiles (cropped with object-fit) so mixed
  // landscape/portrait sources line up, led by one photo at double size. While
  // a lazy-loaded photo is still downloading, an animated shimmer placeholder is
  // shown; the opaque photo paints over it once loaded.

  .gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;

    @media (min-width: $breakpoint-md) {
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }
  }

  /* The tile sets the shape and the photo fills it, so no photo's own proportions can stretch a row. */
  .gallery-item {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: $iop-radius-sm;

    /* Below md the lead photo is a full-width row of its own; from md it takes two columns and two rows. */
    &:first-child {
      grid-column: span 2;

      @media (min-width: $breakpoint-md) {
        grid-row: span 2;
        aspect-ratio: auto;
      }
    }
  }

  .gallery-img {
    position: absolute;
    inset: 0;
    width: 100%;
    /* Overrides the intrinsic height Astro emits, so the photo fills the tile instead. */
    height: 100%;
    object-fit: cover;
    background-color: $iop-placeholder;
    background-image: linear-gradient(
      100deg,
      rgba(255, 255, 255, 0) 35%,
      rgba(255, 255, 255, 0.55) 50%,
      rgba(255, 255, 255, 0) 65%
    );
    background-repeat: no-repeat;
    background-size: 200% 100%;
    animation: gallery-shimmer 1.4s linear infinite;
  }

  @keyframes gallery-shimmer {
    from { background-position: 150% 0; }
    to   { background-position: -50% 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-img {
      animation: none;
    }
  }
</style>
