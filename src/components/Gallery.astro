---
import { Picture } from 'astro:assets'
import type { Gallery } from '../data/galleries'

interface Props {
  gallery: Gallery
}

const { gallery } = Astro.props

/*
 * Three columns from md, two below. The lead photo spans two of them, so it
 * gets its own, larger candidates. The container tops out at 1320px, so a
 * single tile is never wider than ~430px and the lead never wider than ~870px.
 */
const TILE = { widths: [400, 620, 900], sizes: '(min-width: 768px) 31vw, 46vw' }
const LEAD = { widths: [620, 900, 1300], sizes: '(min-width: 768px) 62vw, 94vw' }
---

<div class="gallery">
  {gallery.photos.map((photo, index) => (
    <div class="gallery-item">
      <Picture
        src={photo}
        formats={['avif', 'webp']}
        {...(index === 0 ? LEAD : TILE)}
        alt={`${gallery.alt}, photo ${index + 1} of ${gallery.photos.length}`}
        class="gallery-img"
        loading="lazy"
        decoding="async"
      />
    </div>
  ))}
</div>
