---
import IconBoxArrowUpRight from './icons/IconBoxArrowUpRight.astro'
import { FORM_LINK } from '../config/site'
---

{/* Below md the nav's Apply button is folded away, so this follows the reader between the hero and the finale. */}
<div class="iop-sticky-apply d-md-none">
  <span>Summer 2027 · 4 temples</span>
  <a class="btn btn-primary" href={FORM_LINK} target="_blank" rel="noopener noreferrer">
    Apply now
    <IconBoxArrowUpRight width="1em" height="1em" />
  </a>
</div>

<style lang="scss">
  @use "../styles/tokens" as *;

  .iop-sticky-apply {
    position: fixed;
    right: 0.75rem;
    bottom: calc(0.75rem + env(safe-area-inset-bottom));
    left: 0.75rem;
    z-index: 1020;
    display: flex;
    gap: 0.75rem;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 0.6rem 0.6rem 1.1rem;
    border-radius: $iop-radius-pill;
    background-color: rgba(255, 255, 255, 0.94);
    backdrop-filter: saturate(180%) blur(12px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
    font-size: 0.85rem;
    font-weight: 600;
    color: $iop-ink;
    visibility: hidden;
    opacity: 0;
    transform: translateY(1rem);
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s;

    &.is-visible {
      visibility: visible;
      opacity: 1;
      transform: none;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .iop-sticky-apply {
      transition: none;
    }
  }
</style>

<script>
  const bar = document.querySelector('.iop-sticky-apply')
  const anchors = document.querySelectorAll('.iop-hero, .iop-finale, .footer')

  if (bar && anchors.length) {
    /* The hero and finale carry their own Apply buttons, and the footer should not be covered. */
    const visible = new Set<Element>()
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => entry.isIntersecting ? visible.add(entry.target) : visible.delete(entry.target))
      bar.classList.toggle('is-visible', visible.size === 0)
    })
    anchors.forEach((anchor) => observer.observe(anchor))
  }
</script>
