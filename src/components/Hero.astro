---
import type { ImageMetadata } from 'astro'
import { Picture } from 'astro:assets'
import PageHeading from './PageHeading.astro'
import IconBoxArrowUpRight from './icons/IconBoxArrowUpRight.astro'
import { FORM_LINK } from '../config/site'

interface Props {
  image: ImageMetadata
  alt: string
  /** Candidate widths for the photo. The largest should not exceed the source. */
  widths?: number[]
  eyebrow: string
  /** The button beside Apply. */
  action: { href: string; label: string }
  /** An inner page's hero: the same photo treatment, but it hands over to the content sooner. */
  compact?: boolean
  /** For a bright photo with people right behind the text: shades the left, where the text sits, as well as the bottom. */
  shaded?: boolean
  /** For a hero with no card pulled up over it, so it needs no room left at the bottom. */
  bare?: boolean
}

const { image, alt, widths = [640, 960, 1280, 1600], eyebrow, action, compact = false, shaded = false, bare = false } = Astro.props
---

{/* The photo a page opens on. The headline goes in the `headline` slot and the standfirst in the default one. */}
<section class:list={['iop-hero', { 'iop-hero-compact': compact, 'iop-hero-shaded': shaded, 'iop-hero-bare': bare }]}>
  <Picture
    src={image}
    formats={['avif', 'webp']}
    widths={widths}
    sizes="100vw"
    class="iop-hero-img"
    alt={alt}
    loading="eager"
    fetchpriority="high"
  />
  <div class="container">
    <PageHeading eyebrow={eyebrow} size={compact ? 'page' : 'display'}>
      <slot name="headline" slot="headline" />
      <slot />
    </PageHeading>
    <div class="iop-hero-actions">
      <a class="btn btn-primary btn-lg" href={FORM_LINK} target="_blank" rel="noopener noreferrer">
        Apply now
        <IconBoxArrowUpRight width="1em" height="1em" />
      </a>
      <a class="btn btn-outline-light btn-lg" href={action.href}>{action.label}</a>
    </div>
  </div>
</section>

<style lang="scss">
  .iop-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    min-height: 92svh;
    padding-top: var(--nav-height);
    /* Leaves room for the card pulled up over the photo: the stats card or the jump links. */
    padding-bottom: 7rem;
    overflow: hidden;
    color: #fff;
    background-color: #1f2a17;

    /* Darkens the forest floor where the text sits, leaving the canopy bright. */
    &::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      background: linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.05) 0%,
        rgba(0, 0, 0, 0.25) 45%,
        rgba(0, 0, 0, 0.78) 100%
      );
    }
  }

  .iop-hero-shaded::before {
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0.2) 60%, transparent 85%),
      linear-gradient(180deg, rgba(0, 0, 0, 0.3) 0%, rgba(0, 0, 0, 0.45) 45%, rgba(0, 0, 0, 0.82) 100%);
  }

  .iop-hero-compact {
    min-height: min(78svh, 46rem);
  }

  .iop-hero-bare {
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .iop-hero-img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
  }

  .iop-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
  }
</style>
