---
import { Image } from 'astro:assets'
import type { Participant } from '../data/programs'
import { portrait } from '../data/galleries'

interface Props {
  person: Participant
}

const { person } = Astro.props

/* The portrait is capped at 8rem, and fills a third of the width on the smallest screens. */
const WIDTHS = [128, 256, 384]
const SIZES = '(min-width: 576px) 8rem, 28vw'
---

<figure class="portrait-card">
  <Image
    src={portrait(person.portrait)}
    widths={WIDTHS}
    sizes={SIZES}
    format="webp"
    alt={`Portrait of ${person.name}`}
    loading="lazy"
    decoding="async"
  />
  <figcaption>
    <strong>{person.name}</strong>
    <span><span aria-hidden="true">{person.flag}</span> {person.location}</span>
  </figcaption>
</figure>

<style lang="scss">
  @use "../styles/tokens" as *;

  /* A participant, ringed like the testimonial faces on the home page. */
  .portrait-card {
    margin: 0;
    text-align: center;

    img {
      display: block;
      width: 100%;
      max-width: 8rem;
      height: auto;
      aspect-ratio: 1;
      margin: 0 auto 0.85rem;
      object-fit: cover;
      border-radius: 50%;
      box-shadow: $iop-avatar-ring, 0 10px 24px rgba(0, 0, 0, 0.1);
      background-color: $iop-placeholder;
    }

    strong {
      display: block;
      font-size: 0.95rem;
      line-height: 1.3;
      color: $iop-ink;
    }

    figcaption > span {
      display: block;
      margin-top: 0.2rem;
      font-size: 0.8rem;
      color: var(--bs-secondary-color);
    }
  }
</style>
