---
interface Props {
  /** Names the nav for screen readers, such as "On this page". */
  label: string
  links: { href: string; label: string | number; detail?: string }[]
}

const { label, links } = Astro.props
---

{/* Links to the sections of a page, on a white card pulled up over the bottom of the hero. */}
<div class="container">
  <nav class:list={['iop-jump', { 'iop-jump-four': links.length === 4 }]} aria-label={label}>
    <ul>
      {links.map((link) => (
        <li>
          <a href={link.href}>
            <strong>{link.label}</strong>
            {link.detail !== undefined && <small>{link.detail}</small>}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</div>

<style lang="scss">
  @use "../styles/mixins" as *;
  @use "../styles/tokens" as *;

  .iop-jump {
    @include float-card;

    ul {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem 1rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    a {
      display: block;
      height: 100%;
      color: inherit;
      text-decoration: none;

      &:hover strong,
      &:focus-visible strong {
        text-decoration: underline;
        text-underline-offset: 0.2em;
      }
    }

    strong {
      display: block;
      font-size: clamp(1.05rem, 2vw, 1.2rem);
      font-weight: 800;
      letter-spacing: -0.01em;
      color: $orange-800;
    }

    small {
      display: block;
      margin-top: 0.2rem;
      font-size: 0.85rem;
      color: var(--bs-secondary-color);
    }

    @media (min-width: $breakpoint-md) {
      padding: 2rem 2.25rem;

      ul {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    /* One row, so the dividers can come back without starting a second line. */
    @media (min-width: $breakpoint-xl) {
      ul {
        grid-template-columns: repeat(6, 1fr);
      }

      li + li {
        padding-left: 1.25rem;
        border-left: 1px solid $iop-line;
      }
    }
  }

  /* Four links split two and two, rather than three and an orphan, until there is room for one row.
   * Comes after .iop-jump, whose columns it overrides. */
  .iop-jump-four {
    @media (min-width: $breakpoint-md) {
      ul {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (min-width: $breakpoint-lg) {
      ul {
        grid-template-columns: repeat(4, 1fr);
      }

      li + li {
        padding-left: 1.25rem;
        border-left: 1px solid $iop-line;
      }
    }
  }
</style>
