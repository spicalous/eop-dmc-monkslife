---
import { Image } from 'astro:assets'
import NavItem from './NavItem.astro'
import IconBoxArrowUpRight from './icons/IconBoxArrowUpRight.astro'
import { FORM_LINK } from '../config/site'
import logo from '../assets/images/logo-monks-life.png'

/* Trailing slashes differ between dev and the built site, so compare without them. */
const normalize = (path: string) => path.replace(/\/+$/, '') || '/'
const path = normalize(Astro.url.pathname)
const aboutActive = ['/about', '/about/teachers'].includes(path)
const mediaActive = ['/media', '/media/podcast'].includes(path)
---

<nav class="navbar fixed-top navbar-expand-md site-nav">
  <div class="container-fluid">
    <a class="navbar-brand" href="/">
      {/* Height is left for Astro to derive: the source is 959x1004, so pinning it to 32 square squashes it. */}
      <Image src={logo} width={32} densities={[1, 2]} format="webp" alt="Monk's Life logo" loading="eager" />
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#site-nav-menu" aria-controls="site-nav-menu" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="site-nav-menu">
      <ul class="navbar-nav ms-auto align-items-md-center">
        <NavItem href="/" title="Being a Monk" />

        {/*
          * Below the expand breakpoint Bootstrap renders these menus inline
          * inside the collapsed panel, so one set of markup serves both.
          */}
        <li class="nav-item dropdown">
          <a class={`nav-link dropdown-toggle${aboutActive ? ' active' : ''}`} data-bs-toggle="dropdown" href="/about/" aria-current={path === '/about' ? 'page' : undefined} role="button" aria-expanded="false">Program details</a>
          <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="/about/">About</a></li>
            <li><a class="dropdown-item" href="/about/#program-details--latest-news">Latest news</a></li>
            <li><a class="dropdown-item" href="/about/#program-details--what-is-the-european-ordination-program">What is the European Ordination Program?</a></li>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item" href="/about/teachers/">Teachers</a></li>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item" href="/about/#program-details--temples-in-europe">Temples in Europe</a></li>
          </ul>
        </li>

        <li class="nav-item dropdown">
          <a class={`nav-link dropdown-toggle${mediaActive ? ' active' : ''}`} data-bs-toggle="dropdown" href="/media/" aria-current={path === '/media' ? 'page' : undefined} role="button" aria-expanded="false">Media</a>
          <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="/media/">European ordination program</a></li>
            <li><a class="dropdown-item" href="/media/podcast/">Podcast</a></li>
          </ul>
        </li>

        <NavItem href="/testimonials/" title="Testimonials" />

        <li class="nav-item mt-2 mt-md-0">
          <a class="btn btn-primary nav-apply" href={FORM_LINK} target="_blank" rel="noopener noreferrer">
            Apply
            <IconBoxArrowUpRight width="13" height="13" />
          </a>
        </li>
      </ul>
    </div>
  </div>
</nav>

<style lang="scss">
  @use "../styles/functions" as *;
  @use "../styles/tokens" as *;

  /* Mirrors the `navbar-expand-md` class above. Above it the bar is a row of
   * links; below it everything lives in the collapsed panel. */
  $nav-expand: $breakpoint-md;

  /* Published as --nav-height so anchor offsets stay in step with the bar. */
  $nav-height: 60px;
  $nav-link-color: shade-color($orange-600, 10%);
  $nav-inset: 0.85rem;

  :global(:root) {
    --nav-height: #{$nav-height};
  }

  .site-nav {
    --bs-navbar-padding-y: 0;
    --bs-navbar-toggler-focus-width: 0;
    /* A data URI cannot interpolate a Sass colour: this stroke is #{$orange-700}. */
    --bs-navbar-toggler-icon-bg: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='%23F57C00' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2.2' d='M4 8h22M4 15h22M4 22h22'/%3e%3c/svg%3e");

    min-height: var(--nav-height);
    background-color: rgba(255, 255, 255, 0.88);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid $iop-line-soft;
    transition: background-color 0.25s ease, box-shadow 0.25s ease;

    /* Without the blur there is nothing to soften what scrolls underneath. */
    @supports not (backdrop-filter: blur(1px)) {
      background-color: rgba(255, 255, 255, 0.97);
    }

    /* Set by the script below once the page leaves the top, so the bar lifts
     * off the content instead of carrying a shadow it has not earned. */
    &.is-scrolled {
      background-color: rgba(255, 255, 255, 0.94);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.07);
    }

    .navbar-brand {
      display: flex;
      align-items: center;
      padding-block: 0;
    }

    .navbar-toggler {
      border: 0;
      padding: 0.4rem 0.5rem;
      border-radius: 0.5rem;

      &:focus-visible {
        outline: 2px solid $iop-focus-color;
        outline-offset: 2px;
      }
    }

    /*
     * The bar's height comes from centring a short row inside min-height. Opening
     * the collapsed menu adds a second flex line, leaving nothing to centre, and
     * the row drops to the top — so the row carries the height itself.
     */
    .navbar-brand,
    .navbar-toggler {
      min-height: var(--nav-height);
    }

    /* In the collapsed panel sub-menus sit inline under their parent, so the
     * current page is marked by a rule down the left rather than an underline. */
    .navbar-collapse {
      padding-bottom: 0.5rem;
    }

    /* Half of the links are rendered by NavItem.astro, outside this component's
     * scope, so every .nav-link selector is :global. */
    .navbar-nav :global(.nav-link) {
      position: relative;
      padding-left: $nav-inset;
      color: $nav-link-color;
      font-weight: 500;
      transition: color 0.2s ease;

      &::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.4rem;
        bottom: 0.4rem;
        width: 3px;
        border-radius: 3px;
        background-color: $orange-600;
        opacity: 0;
        transition: opacity 0.2s ease;
      }

      &:hover,
      &:focus-visible,
      &.active,
      &.show {
        color: $orange-800;
      }

      &.active::before {
        opacity: 1;
      }
    }

    .dropdown-menu {
      --bs-dropdown-padding-x: 0.4rem;
      --bs-dropdown-padding-y: 0.4rem;
      --bs-dropdown-item-padding-y: 0.45rem;
      --bs-dropdown-item-padding-x: 0.85rem;
      --bs-dropdown-link-hover-bg: #{$orange-50};
      --bs-dropdown-link-hover-color: #{$orange-900};
      --bs-dropdown-link-active-bg: #{$orange-600};
      --bs-dropdown-divider-bg: #{$iop-line};
    }

    .dropdown-item {
      border-radius: 0.4rem;
      white-space: normal;
    }

    .nav-apply {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      /* Lines the button up with the indented links in the collapsed panel. */
      margin-left: $nav-inset;
    }

    @media (min-width: $nav-expand) {
      .navbar-collapse {
        padding-bottom: 0;
      }

      .navbar-nav :global(.nav-link) {
        padding-inline: $nav-inset;

        /* Grows out from the middle on hover, and stays put on the current page. */
        &::before {
          left: $nav-inset;
          right: $nav-inset;
          top: auto;
          bottom: 0.3rem;
          width: auto;
          height: 2px;
          opacity: 1;
          transform: scaleX(0);
          transition: transform 0.25s ease;
        }

        &:hover::before,
        &:focus-visible::before,
        &.active::before {
          transform: scaleX(1);
        }
      }

      /* Sub-menu labels run long, so give them room without stretching the bar. */
      .dropdown-menu {
        min-width: 15rem;
        max-width: 22rem;
        margin-top: 0.35rem;
        border-color: transparent;
        border-radius: 0.75rem;
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
      }

      .nav-apply {
        margin-left: 0.5rem;
      }
    }

    @media (prefers-reduced-motion: no-preference) {
      .navbar-brand {
        transition: transform 0.2s ease;
      }

      .navbar-brand:hover {
        transform: translateY(-1px);
      }

      .dropdown-menu.show {
        animation: site-nav-drop-in 0.18s ease-out;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .navbar-nav :global(.nav-link),
      .navbar-nav :global(.nav-link)::before {
        transition: none;
      }
    }
  }

  @keyframes site-nav-drop-in {
    from {
      opacity: 0;
      transform: translateY(-0.35rem);
    }
  }
</style>

<script>
  /* The bar is flat against the page until you scroll, then it lifts. */
  const nav = document.querySelector('.site-nav')

  if (nav) {
    const sync = () => nav.classList.toggle('is-scrolled', window.scrollY > 8)
    sync()
    document.addEventListener('scroll', sync, { passive: true })
  }
</script>
