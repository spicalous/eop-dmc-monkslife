---
import { Image } from 'astro:assets'
import NavItem from './NavItem.astro'
import IconBoxArrowUpRight from './icons/IconBoxArrowUpRight.astro'
import { FORM_LINK } from '../config/site'
import logo from '../assets/images/logo-monks-life.png'

/* Trailing slashes differ between dev and the built site, so compare without them. */
const normalize = (path: string) => path.replace(/\/+$/, '') || '/'
const path = normalize(Astro.url.pathname)
const aboutActive = ['/about', '/about/teachers'].includes(path)
const mediaActive = ['/media', '/media/podcast'].includes(path)
---

<nav class="navbar fixed-top navbar-expand-md site-nav">
  <div class="container-fluid">
    <a class="navbar-brand" href="/">
      {/* Height is left for Astro to derive: the source is 959x1004, so pinning it to 32 square squashes it. */}
      <Image src={logo} width={32} densities={[1, 2]} format="webp" alt="Monk's Life logo" loading="eager" />
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#site-nav-menu" aria-controls="site-nav-menu" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="site-nav-menu">
      <ul class="navbar-nav ms-auto align-items-md-center">
        <NavItem href="/" title="Being a Monk" />

        {/*
          * Below the expand breakpoint Bootstrap renders these menus inline
          * inside the collapsed panel, so one set of markup serves both.
          */}
        <li class="nav-item dropdown">
          <a class={`nav-link dropdown-toggle${aboutActive ? ' active' : ''}`} data-bs-toggle="dropdown" href="/about/" aria-current={path === '/about' ? 'page' : undefined} role="button" aria-expanded="false">Program details</a>
          <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="/about/">About</a></li>
            <li><a class="dropdown-item" href="/about/#program-details--latest-news">Latest news</a></li>
            <li><a class="dropdown-item" href="/about/#program-details--what-is-the-european-ordination-program">What is the European Ordination Program?</a></li>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item" href="/about/teachers/">Teachers</a></li>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item" href="/about/#program-details--temples-in-europe">Temples in Europe</a></li>
          </ul>
        </li>

        <li class="nav-item dropdown">
          <a class={`nav-link dropdown-toggle${mediaActive ? ' active' : ''}`} data-bs-toggle="dropdown" href="/media/" aria-current={path === '/media' ? 'page' : undefined} role="button" aria-expanded="false">Media</a>
          <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="/media/">European ordination program</a></li>
            <li><a class="dropdown-item" href="/media/podcast/">Podcast</a></li>
          </ul>
        </li>

        <NavItem href="/testimonials/" title="Testimonials" />

        <li class="nav-item mt-2 mt-md-0">
          <a class="btn btn-primary nav-apply" href={FORM_LINK} target="_blank" rel="noopener noreferrer">
            Apply
            <IconBoxArrowUpRight width="13" height="13" />
          </a>
        </li>
      </ul>
    </div>
  </div>
</nav>

<script>
  /* The bar is flat against the page until you scroll, then it lifts. */
  const nav = document.querySelector('.site-nav')

  if (nav) {
    const sync = () => nav.classList.toggle('is-scrolled', window.scrollY > 8)
    sync()
    document.addEventListener('scroll', sync, { passive: true })
  }
</script>
