---
import IconBoxArrowUpRight from './icons/IconBoxArrowUpRight.astro'
import { FORM_LINK } from '../config/site'

interface Props {
  title?: string
  text?: string
  /** For pages that do not list the dates themselves, a second button leads to them. */
  showDates?: boolean
}

const {
  title = 'Your path to inner peace starts here',
  text = 'Pick your temple and send in your application today.',
  showDates = false,
} = Astro.props
---

<section class="iop-finale">
  <div class="container">
    <h2>{title}</h2>
    <p>{text}</p>
    <div class="iop-finale-actions">
      <a class="btn btn-light btn-lg" href={FORM_LINK} target="_blank" rel="noopener noreferrer">
        Apply now
        <IconBoxArrowUpRight width="1em" height="1em" />
      </a>
      {showDates && <a class="btn btn-outline-light btn-lg" href="/about/#program-details--latest-news">See the dates</a>}
    </div>
  </div>
</section>

<style lang="scss">
  @use "../styles/tokens" as *;

  .iop-finale {
    padding-block: clamp(4rem, 10vw, 7rem);
    text-align: center;
    color: #fff;
    background:
      radial-gradient(circle at 20% 0%, rgba(255, 255, 255, 0.18), transparent 55%),
      linear-gradient(135deg, $orange-600, $orange-900);

    h2 {
      margin-bottom: 1rem;
      font-size: clamp(2.1rem, 6vw, 3.75rem);
      font-weight: 800;
      line-height: 1.05;
      letter-spacing: -0.03em;
    }

    p {
      margin-bottom: 2rem;
      font-size: 1.2rem;
      color: rgba(255, 255, 255, 0.92);
    }

    .btn-light {
      --bs-btn-color: #{$orange-900};
      --bs-btn-hover-color: #{$orange-900};
      --bs-btn-active-color: #{$orange-900};
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.18);
    }
  }

  .iop-finale-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
  }

  /* The footer's own margin would leave a white strip under the orange band. */
  .iop-finale ~ :global(.footer) {
    margin-top: 0;
  }
</style>
