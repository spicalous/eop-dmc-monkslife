---
interface Props {
  /** YouTube video id on its own, with no URL or query string. */
  id: string
  /** Names the play link, and the player once it loads. */
  title: string
}

const { id, title } = Astro.props
---

{/*
  * Shows the video's thumbnail and loads YouTube's player only when it is played, so a page of several videos
  * costs a few small images rather than several players. Without JavaScript the link opens the video on YouTube.
  */}
<div class="ratio ratio-16x9 yt-facade">
  <a
    href={`https://www.youtube.com/watch?v=${id}`}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`Play video: ${title}`}
    data-video-id={id}
    data-title={title}
  >
    <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" width="480" height="360" loading="lazy" decoding="async">
    <span class="yt-facade-play" aria-hidden="true"></span>
  </a>
</div>

<style lang="scss">
  @use "../styles/tokens" as *;

  .yt-facade {
    overflow: hidden;
    border-radius: 0.75rem;
    background-color: #000;

    a {
      display: block;
    }

    /*
     * Most thumbnails are 4:3 with the 16:9 frame letterboxed inside, so cropping to the frame trims the black bars.
     * The slight zoom hides the sliver of bar some leave behind.
     */
    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transform: scale(1.02);
      transition: transform 0.3s ease;
    }

    a:hover img,
    a:focus-visible img {
      transform: scale(1.06);
    }

    /* The player is put in by the script below, so it carries no scope of its own. */
    :global(iframe) {
      border: 0;
    }
  }

  .yt-facade-play {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background-color: rgba(0, 0, 0, 0.6);
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.85);
    transform: translate(-50%, -50%);
    transition: background-color 0.2s ease;

    &::before {
      content: "";
      position: absolute;
      inset: 0;
      margin: auto;
      width: 1.25rem;
      height: 1.4rem;
      background-color: #fff;
      clip-path: polygon(0 0, 100% 50%, 0 100%);
      transform: translateX(10%);
    }

    a:hover &,
    a:focus-visible & {
      background-color: $orange-800;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .yt-facade img {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLAnchorElement>('.yt-facade a').forEach((link) => {
    link.addEventListener('click', (event) => {
      /* Leaves modified clicks alone, so they still open YouTube in a new tab or window. */
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return
      event.preventDefault()

      const iframe = document.createElement('iframe')
      iframe.src = `https://www.youtube-nocookie.com/embed/${link.dataset.videoId}?autoplay=1`
      iframe.title = link.dataset.title ?? ''
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share'
      iframe.referrerPolicy = 'strict-origin-when-cross-origin'
      iframe.allowFullscreen = true
      link.replaceWith(iframe)
      iframe.focus()
    })
  })
</script>
